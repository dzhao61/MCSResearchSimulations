# The current repository covers the simulation workspace and presentation.
# Other Research folders remain local until explicitly added to this scope.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/Simulations/
!/Thesis Presentation/

# Local metadata, environments, and caches.
.DS_Store
__pycache__/
*.py[cod]
.venv/
.claude/
.mplcache/

# Office and preview temporary files.
~$*
.~lock.*#
